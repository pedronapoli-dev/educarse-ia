# ── Supabase ───────────────────────────────────────────────────
# Local:      http://127.0.0.1:54321 — fixed demo keys from `supabase start`
# Production: set via Vercel dashboard — never commit real keys here
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── API ────────────────────────────────────────────────────────
# Local:      http://localhost:3001
# Production: https://api.educarse-ia.com.br
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Stripe ────────────────────────────────────────────────────
# Always use test-mode publishable key (pk_test_...) locally.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Optional ───────────────────────────────────────────────────
NEXT_PUBLIC_DISCORD_INVITE_URL=   # shows Community card on /conta if set
