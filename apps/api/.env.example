PORT=3001
NODE_ENV=development

# ── Supabase ───────────────────────────────────────────────────
# Local:      run `supabase start` — copy the anon/service keys it prints
# Production: set via Railway dashboard — never commit real keys here
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# JWT_SECRET: `supabase status` → "JWT secret" field
JWT_SECRET=<jwt-secret>

# ── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ────────────────────────────────────────────────────
# Always use test-mode keys (sk_test_...) for local development.
# For webhook secret locally: `stripe listen --forward-to localhost:3001/api/webhook`
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_MAX=price_...
STRIPE_PRICE_ID_BETA=price_...

# ── App ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
YOUTUBE_API_KEY=   # optional — graceful degradation if absent
